# ===========================================
# fly-web — Переменные окружения
# ===========================================
# Скопируйте в .env и заполните значения.
# Сайт статический — .env читает только deploy.ps1.

# ─── Деплой (SSH) ───
DEPLOY_SSH_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=root
DEPLOY_SSH_KEY=../ssh-private.key
DEPLOY_REMOTE_PATH=/var/www/fly.nayanovaacademy.ru/public/
